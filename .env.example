# ============================================================
#  НАСТРОЙКИ БОТА
#  1) Скопируйте этот файл под именем  .env   (cp .env.example .env)
#  2) Заполните две обязательные строки ниже
#  3) Остальное можно не трогать — всё работает «из коробки»
# ============================================================

# ---------- ОБЯЗАТЕЛЬНО ----------
# Токен бота — его выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-вставьте-сюда-свой-токен

# Канал: @имя_канала (если канал публичный) или число вида -1001234567890
TELEGRAM_CHANNEL_ID=@my_channel

# ---------- ПОДПИСЬ И ОФОРМЛЕНИЕ ----------
# Подпись в конце каждого поста (как @prepodsteam в вашем образце).
# Пусто — без подписи. Если строку удалить совсем, возьмётся @имя из TELEGRAM_CHANNEL_ID.
CHANNEL_SIGNATURE=@my_channel

# Эмодзи в постах (true/false)
USE_EMOJI=true

# Добавлять строку «Страница в Steam» и «Источник: …» (true/false)
SHOW_STEAM_LINK=true
SHOW_SOURCE_LINK=true

# ---------- РОСТ КАНАЛА ----------
# Кнопка «Подписаться» под каждым постом. Бот сам создаёт пригласительную ссылку.
# Важно: Telegram не даёт боту добавлять подписчиков — это только кнопка-ссылка.
SUBSCRIBE_BUTTON=true
SUBSCRIBE_BUTTON_TEXT=📣 Подписаться на канал

# Считать, сколько человек пришло по каждой ссылке (работает команда: python main.py --stats)
TRACK_JOINS=true

# ---------- СТИЛЬ ПОСТОВ ----------
# prepod    — как «ПРЕПОД STEAM»: строгий заголовок, короткий текст, без лишних эмодзи
# stars     — как «PlayStation Stars»: факты списком «•», подпись «🌟 @канал ✨»
# platforma — как «Платформа»: эмодзи-акцент, пункты 🤩, вопрос читателям в конце
POST_STYLE=prepod

# Вопрос читателям в конце поста (работает только в стиле platforma)
POST_QUESTION=true

# ---------- ГОРЯЧИЕ НОВОСТИ ----------
# Следить за лентами и публиковать самое интересное сразу, не дожидаясь планового поста
HOT_NEWS=true

# Порог «интересности»: чем выше, тем реже внеплановые посты
# 4.5 — часто, 5.0 — баланс, 5.5 — только очень крупное
HOT_MIN_SCORE=5.0

# Минимальная пауза между любыми постами, минут (защита от спама)
HOT_MIN_GAP_MINUTES=25

# Как часто проверять ленты, секунд (600 = раз в 10 минут)
POLL_SECONDS=600

# ---------- РАСПИСАНИЕ ----------
# Как часто публиковать, в минутах (90 = примерно 16 постов в сутки без «тихих часов»)
POST_INTERVAL_MINUTES=90

# «Тихие часы», когда бот молчит (по вашему часовому поясу). Пусто — публиковать круглосуточно.
QUIET_HOURS=0-8

# Не больше стольких постов в сутки
MAX_POSTS_PER_DAY=12

# Ваш часовой пояс. Примеры: Europe/Moscow, Europe/Kyiv, Europe/Minsk, Asia/Almaty, Europe/Berlin
TIMEZONE=Europe/Moscow

# ---------- ЧТО ПУБЛИКОВАТЬ ----------
# Источники: Steam (релизы, раздачи, скидки, анонсы) и RSS-ленты из файла feeds.txt
ENABLE_STEAM=true
ENABLE_RSS=true

# Какие типы постов делать из Steam: release (вышла), free (раздача),
# discount (большая скидка), upcoming (скоро выйдет)
STEAM_KINDS=release,free,discount,upcoming

# Скидки показываем от стольких процентов
MIN_DISCOUNT=60

# Цены в каких регионах показывать (как в образце: ₽/₸/₴/€/$)
PRICE_REGIONS=ru,kz,ua,de,us

# Релиз считается свежим, если вышел не раньше чем N дней назад
RELEASE_MAX_AGE_DAYS=10

# Не публиковать игры с контентом 18+ (рекомендуется: Telegram блокирует такие каналы)
SKIP_ADULT=true

# ---------- КАРТИНКИ И ТРЕЙЛЕРЫ ----------
# Сколько скриншотов прикладывать (0 — только трейлер/обложка)
MAX_SCREENSHOTS=2

# Прикладывать трейлеры (true/false)
SEND_TRAILERS=true

# Трейлеры Steam отдаёт потоком; чтобы превратить их в видео, нужна бесплатная программа ffmpeg
# (в инструкции есть, как её поставить). Без ffmpeg посты будут выходить без видео.
USE_FFMPEG=true
MAX_VIDEO_SECONDS=150

# ============================================================
#  НЕОБЯЗАТЕЛЬНО (можно оставить пустым)
# ============================================================

# --- ИИ-перевод ---
# Нужен только если хотите брать новости с английских сайтов и переводить их на русский,
# а также переводить описания игр, у которых в Steam нет русского текста.
# Подходит любой сервис с «OpenAI-совместимым» API. У нескольких есть бесплатные тарифы с лимитами
# (условия меняются — проверьте на сайте сервиса). Примеры:
#   Google AI Studio:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:              AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL — название модели из списка на сайте сервиса (названия иногда меняются).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- YouTube ---
# Бесплатный ключ YouTube Data API v3. Если задан и видео-трейлер Steam получить не удалось,
# бот попробует найти официальный трейлер на YouTube и добавить ссылку на него.
YOUTUBE_API_KEY=

# --- Служебное ---
LOG_LEVEL=INFO
