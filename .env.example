# ==============================================================================
# Telegram Game News Bot - Configuration Template
# ==============================================================================

# Core Telegram Bot Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHANNEL_ID=@gameworld2029

# Admin & Delivery Configuration (Requirement R1 & R3)
ADMIN_TELEGRAM_ID=987654321
SEND_SHORTS_TO_ADMIN=true

# AI Evergreen Content Module (Requirement R2 & R3)
ENABLE_EVERGREEN=true
AI_PROVIDER=openai
AI_API_KEY=sk-proj-your-api-key-here
AI_MODEL=gpt-4o-mini

# Database & External Paths
DATABASE_PATH=bot.db
FFMPEG_PATH=ffmpeg
WATERMARK_TEXT=@gameworld2029
VIDEO_OUTPUT_DIR=temp/shorts

# ---------- ПЯТНИЧНАЯ ПОДБОРКА СКИДОК ----------
# Раз в неделю бот публикует одним постом самые популярные игры Steam со скидкой
DIGEST_ENABLED=true
# День недели (пятница, fri или число 0-6, где 0 — понедельник) и час публикации (по вашему часовому поясу)
DIGEST_WEEKDAY=пятница
DIGEST_HOUR=18
# Скидка от скольких процентов, сколько отзывов в Steam считаем «популярной» игрой, сколько игр в списке
DIGEST_MIN_DISCOUNT=30
DIGEST_MIN_REVIEWS=20000
DIGEST_MAX_ITEMS=12

# Строка-рубрика над заголовком («🎁 ХАЛЯВА», «🎬 НОВЫЙ ТРЕЙЛЕР», «🏢 СТУДИИ И ИНДУСТРИЯ»...)
RUBRIC_LABELS=true
